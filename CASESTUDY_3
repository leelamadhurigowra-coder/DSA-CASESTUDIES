import java.util.*;

public class PromotionBFS {

    static List<String> bfsLimited(
            Map<String, List<String>> adj,
            String source,
            int maxDepth) {

        Queue<String> queue =
                new LinkedList<>();

        Queue<Integer> depthQueue =
                new LinkedList<>();

        Set<String> visited =
                new HashSet<>();

        List<String> result =
                new ArrayList<>();

        queue.offer(source);
        depthQueue.offer(0);

        visited.add(source);

        while (!queue.isEmpty()) {

            String current =
                    queue.poll();

            int depth =
                    depthQueue.poll();

            // Prune deeper levels
            if (depth > maxDepth)
                continue;

            // Add current node
            result.add(current);

            // Expand neighbours
            for (String next :
                    adj.getOrDefault(
                            current,
                            Collections.emptyList())) {

                if (!visited.contains(next)) {

                    visited.add(next);

                    queue.offer(next);

                    depthQueue.offer(
                            depth + 1);
                }
            }
        }

        return result;
    }

    public static void main(String[] args) {

        Map<String, List<String>> adj =
                new HashMap<>();

        adj.put("R",
                Arrays.asList("S", "T"));

        adj.put("S",
                Arrays.asList("U", "V"));

        adj.put("T",
                Arrays.asList("V", "W"));

        adj.put("U",
                Arrays.asList("X"));

        adj.put("V",
                Arrays.asList("X", "Y"));

        adj.put("W",
                Arrays.asList("Y"));

        List<String> reached =
                bfsLimited(
                        adj,
                        "R",
                        3);

        System.out.println(
                reached);
    }
}
