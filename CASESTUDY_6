import java.util.*;

public class FuelCouponDP
{
    static int minCoupons(
            int[] coupons,
            int amount)
    {
        int[] dp =
                new int[amount + 1];

        Arrays.fill(dp,
                amount + 1);

        dp[0] = 0;

        for (int i = 1;
             i <= amount;
             i++)
        {
            for (int c : coupons)
            {
                if (c <= i &&
                    dp[i - c] != amount + 1)
                {
                    dp[i] = Math.min(
                            dp[i],
                            dp[i - c] + 1);
                }
            }
        }

        return (dp[amount] ==
                amount + 1)
                ? -1
                : dp[amount];
    }

    static List<Integer> couponsUsed(
            int[] coupons,
            int amount)
    {
        int[] dp =
                new int[amount + 1];

        int[] choice =
                new int[amount + 1];

        Arrays.fill(dp,
                amount + 1);

        dp[0] = 0;

        for (int i = 1;
             i <= amount;
             i++)
        {
            for (int c : coupons)
            {
                if (c <= i &&
                    dp[i - c] + 1 < dp[i])
                {
                    dp[i] =
                            dp[i - c] + 1;

                    choice[i] = c;
                }
            }
        }

        List<Integer> result =
                new ArrayList<>();

        if (dp[amount] ==
                amount + 1)
            return result;

        while (amount > 0)
        {
            result.add(
                    choice[amount]);

            amount -=
                    choice[amount];
        }

        return result;
    }

    public static void main(
            String[] args)
    {
        int[] coupons =
        {1, 3, 7, 15, 25};

        int amount = 58;

        System.out.println(
                "Minimum Coupons = "
                + minCoupons(
                        coupons,
                        amount));

        System.out.println(
                "Coupons Used = "
                + couponsUsed(
                        coupons,
                        amount));
    }
}
