import java.util.*;

class Edge
{
    int to;
    int weight;

    Edge(int to, int weight)
    {
        this.to = to;
        this.weight = weight;
    }
}

public class AmbulanceRouting
{
    static int[] dijkstra(
            int n,
            List<List<Edge>> adj,
            int source)
    {
        int[] dist =
                new int[n];

        Arrays.fill(
                dist,
                Integer.MAX_VALUE);

        dist[source] = 0;

        PriorityQueue<int[]> pq =
                new PriorityQueue<>(
                (a,b) ->
                Integer.compare(
                        a[0],
                        b[0]));

        pq.offer(
                new int[]{
                        0,
                        source});

        while(!pq.isEmpty())
        {


            int[] top =
                    pq.poll();

            int d = top[0];
            int u = top[1];

            // Skip stale entries
            if(d > dist[u])
                continue;

            // Relax neighbours
            for(Edge edge :
                    adj.get(u))
            {
                int v = edge.to;
                int w = edge.weight;

                if(dist[u] + w <
                        dist[v])
                {
                    dist[v] =
                            dist[u] + w;

                    pq.offer(
                            new int[]{
                                    dist[v],
                                    v});
                }
            }
        }

        return dist;
    }
}
